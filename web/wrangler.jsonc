{
  // ChurchThrive — Next.js 15 on Cloudflare Workers (OpenNext)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "churchthrive",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "church.havrutaproject.org", "custom_domain": true },
    { "pattern": "church-thrive.org", "custom_domain": true },
    { "pattern": "www.church-thrive.org", "custom_domain": true }
  ],
  "vars": {
    // 정본 도메인 — 초대 링크·플랫폼 메일 등 서버 생성 절대 URL의 origin
    "NEXT_PUBLIC_SITE_URL": "https://church-thrive.org",
    "NEXT_PUBLIC_SUPABASE_URL": "https://fcnbbumpjqhycpbhlyfk.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZjbmJidW1wanFoeWNwYmhseWZrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMzMTI2NzIsImV4cCI6MjA5ODg4ODY3Mn0.6aD6V7UToC-cV1Z_ytfh0K266105yuN22lACOrjuxGQ"
  }
}
